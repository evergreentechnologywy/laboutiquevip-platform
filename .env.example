# APP CONFIG
APP_URL=https://www.laboutiquevip.net
JWT_SECRET=your-secure-jwt-secret-here
PORT=3000

# DATABASE
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# AWS S3 / COMPATIBLE STORAGE (e.g. Supabase, R2, MinIO)
S3_ENDPOINT=https://your-endpoint.com
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_PUBLIC_BASE_URL=https://your-public-cdn-url.com
S3_FORCE_PATH_STYLE=true

# EXTERNAL SERVICES
DIDIT_API_KEY=your-didit-api-key
DIDIT_WEBHOOK_SECRET=your-didit-webhook-secret
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-webhook-secret
TICKETMASTER_API_KEY=your-ticketmaster-consumer-key
TICKETMASTER_CONSUMER_KEY=your-ticketmaster-consumer-key
TICKETMASTER_CONSUMER_SECRET=your-ticketmaster-consumer-secret
TICKETMASTER_AFFILIATE_ID=optional-ticketmaster-affiliate-id

# VPS import control (backend writes trigger files; orchestrator cron consumes them)
LBV_TRIGGER_DIR=/var/run/lboutiquevip
LBV_LOG_DIR=/var/log/laboutiquevip
IMPORT_MAINTENANCE_MODE=soft
IMPORT_FLAG_PATH=/var/run/lboutiquevip/import-in-progress
IMPORT_MANUAL_PATH=/var/run/lboutiquevip/maintenance-manual.json
IMPORT_MAINTENANCE_RETRY_AFTER=900

# Frontend affiliate IDs (omit to hide affiliate links in UI)
VITE_NORDVPN_AFF_ID=
VITE_BOOKING_AFF_ID=
VITE_TEXTVERIFIED_AFF_ID=
VITE_STRIPE_AFF_ID=
VITE_KNOWNHOST_AFF_ID=
TRAVELPAYOUTS_LOGIN_EMAIL=optional-travelpayouts-login-email
TRAVELPAYOUTS_ACCOUNT_ID=optional-travelpayouts-account-id
TRAVELPAYOUTS_SOURCE_ID=optional-travelpayouts-source-id
TRAVELPAYOUTS_PROJECT_NAME=optional-travelpayouts-project-name
TRAVELPAYOUTS_PROJECT_URL=https://your-site.example
TRAVELPAYOUTS_DASHBOARD_URL=optional-travelpayouts-dashboard-url
TRAVELPAYOUTS_PROGRAMS_URL=optional-travelpayouts-programs-url
TRAVELPAYOUTS_DRIVE_SCRIPT_URL=optional-review-before-using-third-party-script-url
TRAVELPAYOUTS_REVIEW_STATUS=optional-review-status

# --- Clerk auth (production) ---
# Server-side secret key from Clerk dashboard (API Keys). Required for backend JWT verification.
CLERK_SECRET_KEY=sk_live_replace_me
# Publishable key used by the frontend Clerk provider.
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
# Clerk Frontend API / JWT issuer domain for this app (CNAME clerk.laboutiquevip.net -> frontend-api.clerk.services).
CLERK_JWT_ISSUER=https://clerk.laboutiquevip.net
