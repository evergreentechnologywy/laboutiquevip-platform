# Frontend
VITE_APP_API_URL=https://www.laboutiquevip.net/api
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Backend
API_PORT=8787
NODE_ENV=development
PUBLIC_BASE_URL=https://www.laboutiquevip.net
ALLOW_HEADER_AUTH_TRUST=false
CORS_ALLOWLIST=https://www.laboutiquevip.net
CONTENT_SECURITY_POLICY=default-src 'self'
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
ADMIN_IP_ALLOWLIST=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
RESEND_API_KEY=
RESEND_FROM_EMAIL=payments@laboutiquevip.net

# Confirmo / NOWPayments webhook
CONFIRMO_WEBHOOK_SECRET=replace_with_confirmo_secret
CONFIRMO_WEBHOOK_SIGNATURE_HEADER=x-confirmo-signature

# Didit
DIDIT_API_KEY=replace_with_didit_api_key
DIDIT_WORKFLOW_ID=replace_with_didit_workflow_id
DIDIT_WEBHOOK_SECRET=replace_with_didit_webhook_secret
DIDIT_WEBHOOK_SIGNATURE_HEADER=x-didit-signature
DIDIT_WEBHOOK_TIMESTAMP_HEADER=x-didit-timestamp

# Database
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/trystlike
