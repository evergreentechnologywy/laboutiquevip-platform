[Unit]
Description=La Boutique VIP package expiration reminders
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/apps/trystlike/repo
EnvironmentFile=/srv/apps/trystlike/repo/.env
ExecStart=/usr/bin/node /srv/apps/trystlike/repo/backend/dist/jobs/runPackageExpirationReminders.js
