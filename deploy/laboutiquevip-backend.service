[Unit]
Description=LaboutiqueVIP Backend API
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/srv/apps/trystlike/repo
EnvironmentFile=/srv/apps/trystlike/repo/.env
ExecStart=/usr/bin/node /srv/apps/trystlike/repo/backend/dist/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
